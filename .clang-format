# HemoCell C++ style, derived from the prevailing style of the existing code
# (2-space indentation, attached braces, `Type * name`, unindented namespaces,
# access specifiers at the class indentation). Requires clang-format >= 14.
#
# Format your changes before committing:   git clang-format
# Format whole files:                      scripts/format.sh [paths...]
# Vendored and historical code is excluded (external/.clang-format,
# legacy/.clang-format; palabos/ is generated by setup.sh).
---
Language: Cpp
BasedOnStyle: LLVM
Standard: c++11

IndentWidth: 2
TabWidth: 2
UseTab: Never
ContinuationIndentWidth: 4
ColumnLimit: 120
AccessModifierOffset: -2
NamespaceIndentation: None
IndentCaseLabels: true
IndentPPDirectives: None

BreakBeforeBraces: Attach
AlwaysBreakTemplateDeclarations: Yes
AllowShortBlocksOnASingleLine: Always
AllowShortFunctionsOnASingleLine: Inline
AllowShortIfStatementsOnASingleLine: WithoutElse
AllowShortLoopsOnASingleLine: true
AllowShortLambdasOnASingleLine: All

PointerAlignment: Middle
DerivePointerAlignment: false
SpaceBeforeParens: ControlStatements
Cpp11BracedListStyle: true
SpacesBeforeTrailingComments: 1

# Include order matters in HemoCell (forward declarations precede includes in
# several headers), so includes are never reordered.
SortIncludes: Never
IncludeBlocks: Preserve

# Keep log/error messages as single, greppable string literals.
BreakStringLiterals: false

# Leave comments (ASCII art, aligned explanations) and namespace ends alone.
ReflowComments: false
FixNamespaceComments: false
MaxEmptyLinesToKeep: 2
KeepEmptyLinesAtTheStartOfBlocks: false
...
